# Leave unset to use this Next.js app's same-origin /api/v1 route handlers.
# Set only when intentionally proxying to a separate compatible backend.
# NEXT_PUBLIC_API_URL=https://api.example.com/api/v1

# Guest/demo personal data is memory-only by default. Do not enable this on a
# shared preview unless every visitor has a verified account.
# ALLOW_GUEST_PERSISTENCE=false

# ── Accounts (Clerk) ────────────────────────────────────────────────────────
# Leave these unset for local dev / CI: the app runs in graceful no-auth mode
# (single local scope, behind the site-password gate). Set them to turn on real
# per-user accounts — and, with them on, LOGIN IS REQUIRED before anything in
# the system (every route except the welcome page and /sign-in, /sign-up).
#
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
# CLERK_SECRET_KEY=sk_test_xxx
#
# Where the sign-in wall sends people, and where they land afterward. Keep these
# exactly as below so redirects point at the app's own pages.
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
# NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# ── Job providers (real inventory) ──────────────────────────────────────────
# With NONE of these set, the job feed serves a bundled ~40-job seed pool. A
# provider turns ON the moment its keys are present — there is NO *_ENABLED flag
# (any *_ENABLED lines in the old root .env.example are legacy and ignored).
# Results from all enabled providers are fetched in parallel, deduped, and
# cached in-memory (~10 min).

# Adzuna — the highest-value source: a meta-aggregator that pulls in Indeed,
# Monster, ZipRecruiter, and state boards. Free tier ≈1,000 calls/month.
# Register (instant): https://developer.adzuna.com
# ADZUNA_APP_ID=xxxxxxxx
# ADZUNA_APP_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional tuning (sensible defaults shown):
# ADZUNA_COUNTRY=us
# ADZUNA_KEYWORDS=warehouse,forklift,cdl,cook,custodian
# ADZUNA_MAX_PAGES=1
# ADZUNA_WHERE=            # e.g. "Columbus, Ohio" to bias toward a metro

# USAJobs — federal civilian roles. Free, instant key; USER_AGENT must be the
# email you registered with. Note: federal postings are scored HIGH-risk /
# excludes-felons by design, so most read as "challenging" for people with a
# record — real inventory, but lower fair-chance yield than Adzuna.
# Register: https://developer.usajobs.gov/apirequest
# USAJOBS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
# USAJOBS_USER_AGENT=you@email.com

# Also available with no key at all (remote-heavy): Remotive, RemoteOK, Jobicy,
# Himalayas — see apps/web/lib/providers/ for the full set and their env vars.
