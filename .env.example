# --- App ---
NODE_ENV=development
API_PORT=3001
API_HOST=0.0.0.0

# --- Postgres (matches docker-compose.yml) ---
POSTGRES_USER=dxp
POSTGRES_PASSWORD=dxp_dev_password
POSTGRES_DB=workforce_navigator
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://dxp:dxp_dev_password@localhost:5432/workforce_navigator?schema=public

# --- Redis (used in Phase 4; present now for parity) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Ingestion ---
INGEST_RUN_ON_BOOT=true

# --- USAJobs provider ---
# Register at https://developer.usajobs.gov/apirequest/ (5-minute signup).
# USER_AGENT must be the email you registered with; API_KEY is in the email
# they send back.
USAJOBS_ENABLED=false
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=
USAJOBS_KEYWORDS=warehouse,forklift,maintenance,custodian,cook,driver,clerk,laborer
USAJOBS_MAX_PAGES=4

# --- Adzuna provider ---
# Register at https://developer.adzuna.com. Free tier: ~1000 calls/month.
ADZUNA_ENABLED=false
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us
ADZUNA_KEYWORDS=warehouse,forklift,cdl,cook,custodian
ADZUNA_MAX_PAGES=2
ADZUNA_WHERE=

# --- Remotive provider (no auth required) ---
REMOTIVE_ENABLED=false
REMOTIVE_LIMIT=200
REMOTIVE_CATEGORY=
REMOTIVE_US_ONLY=true

# --- Jooble provider ---
# Register at https://jooble.org/api/about. Default plan = 500 req/month.
# We POST to https://jooble.org/api/{api_key}.
JOOBLE_ENABLED=false
JOOBLE_API_KEY=
JOOBLE_KEYWORDS=warehouse,forklift,cdl driver,maintenance,custodian,cook,landscaping,laborer,manufacturing,housekeeping
JOOBLE_LOCATIONS=United States
JOOBLE_MAX_PAGES=2
JOOBLE_RESULTS_PER_PAGE=20
JOOBLE_RADIUS_KM=40

# --- SerpApi Google Jobs provider ---
# Register at https://serpapi.com/. Free tier = 100 searches / month.
# Each (keyword × location × page) = 1 search; with the defaults below
# = 10 searches per ingestion run. Keep MAX_PAGES low to avoid quota.
SERPAPI_GOOGLE_JOBS_ENABLED=false
SERPAPI_API_KEY=
SERPAPI_GOOGLE_JOBS_KEYWORDS=warehouse,forklift,cdl driver,maintenance,custodian,cook,landscaping,laborer,manufacturing,housekeeping
SERPAPI_GOOGLE_JOBS_LOCATIONS=United States
SERPAPI_GOOGLE_JOBS_MAX_PAGES=1
SERPAPI_GOOGLE_JOBS_GL=us
SERPAPI_GOOGLE_JOBS_HL=en

# --- Accounts / sign-in (Clerk) ---
# Set both keys to turn on real per-user accounts (email + Google + Microsoft).
# Get them from the Clerk dashboard (clerk.com), and enable the three sign-in
# methods there. When these are set:
#   - personal routes (dashboard, plan, onboarding, assessment, caseworker,
#     compare) require sign-in; everything else stays open
#   - each person's data is isolated to their account
#   - the site-password gate below is bypassed (auth replaces it)
# When UNSET, accounts are off and the app runs behind the password gate with a
# single local data scope — exactly the pre-accounts behavior. See docs/auth.md.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Where the sign-in / sign-up pages live (defaults shown; keep these).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# --- Site-wide password gate (web only; fallback when accounts are OFF) ---
# Used only when Clerk keys above are NOT set. Every page redirects to /access
# until this password is entered. Cookie persists for 7 days; rotating this
# value instantly invalidates every existing session.
# REQUIRED unless SITE_GATE=off: there is no fallback password (this repo
# is public — a committed default would be a published password). The gate
# fails closed with 503 until it's set. Use a strong, unique value.
SITE_PASSWORD=
# SITE_GATE=off

# --- Admin auth ---
# Required header on /ingestion/* endpoints when set. If unset, those
# endpoints are open (current dev behavior). On Railway, set this to
# a strong random string and pass it as `x-admin-api-key: <value>` or
# `Authorization: Bearer <value>` when triggering ingestion.
ADMIN_API_KEY=

# --- Auth (Phase 8 — stub now) ---
JWT_SECRET=change_me_in_prod
JWT_EXPIRES_IN=3600
