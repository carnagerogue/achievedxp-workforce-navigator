# Achieve DXP Workforce Navigator — Next.js web app
NODE_ENV=development

# Same-origin /api/v1 is the default. Usually leave this unset.
# NEXT_PUBLIC_API_URL=https://api.example.com/api/v1

# Optional durable storage. Guest personal data remains memory-only unless the
# explicit (and discouraged for shared previews) opt-in is enabled.
DATABASE_URL=
ALLOW_GUEST_PERSISTENCE=false

# Site-wide preview gate used only when Clerk accounts are not configured.
SITE_PASSWORD=
# SITE_GATE=off

# Clerk accounts. Set both to require verified accounts across product routes.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# U.S. Department of Labor CareerOneStop (AJCs, wages, licenses, certs).
COS_USER_ID=
COS_TOKEN=

# USAJobs
USAJOBS_ENABLED=false
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=
USAJOBS_KEYWORDS=warehouse,forklift,maintenance,custodian,cook,driver,clerk,laborer
USAJOBS_MAX_PAGES=4

# Adzuna
ADZUNA_ENABLED=false
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us
ADZUNA_KEYWORDS=warehouse,forklift,cdl,cook,custodian
ADZUNA_MAX_PAGES=2
ADZUNA_WHERE=

# Jooble
JOOBLE_ENABLED=false
JOOBLE_API_KEY=
JOOBLE_KEYWORDS=warehouse,forklift,cdl driver,maintenance,custodian,cook,landscaping,laborer,manufacturing,housekeeping
JOOBLE_LOCATIONS=United States
JOOBLE_MAX_PAGES=2
JOOBLE_RESULTS_PER_PAGE=20
JOOBLE_RADIUS_KM=40

# No-auth providers can be disabled or tuned individually.
REMOTIVE_ENABLED=true
REMOTIVE_LIMIT=200
REMOTIVE_US_ONLY=true
REMOTEOK_ENABLED=true
JOBICY_ENABLED=true
HIMALAYAS_ENABLED=true
MUSE_ENABLED=true
ATS_BOARDS_ENABLED=true
WORKDAY_ENABLED=false

JOBS_CACHE_TTL_SECONDS=600
