# --- App ---
NODE_ENV=development
API_PORT=3001
API_HOST=0.0.0.0

# --- Postgres (matches docker-compose.yml) ---
POSTGRES_USER=dxp
POSTGRES_PASSWORD=dxp_dev_password
POSTGRES_DB=workforce_navigator
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://dxp:dxp_dev_password@localhost:5432/workforce_navigator?schema=public

# --- Redis (used in Phase 4; present now for parity) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Ingestion ---
INGEST_RUN_ON_BOOT=true

# --- USAJobs provider ---
# Register at https://developer.usajobs.gov/apirequest/ (5-minute signup).
# USER_AGENT must be the email you registered with; API_KEY is in the email
# they send back.
USAJOBS_ENABLED=false
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=
USAJOBS_KEYWORDS=warehouse,forklift,maintenance,custodian,cook,driver,clerk,laborer
USAJOBS_MAX_PAGES=4

# --- Adzuna provider ---
# Register at https://developer.adzuna.com. Free tier: ~1000 calls/month.
ADZUNA_ENABLED=false
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us
ADZUNA_KEYWORDS=warehouse,forklift,cdl,cook,custodian
ADZUNA_MAX_PAGES=2
ADZUNA_WHERE=

# --- Remotive provider (no auth required) ---
REMOTIVE_ENABLED=false
REMOTIVE_LIMIT=200
REMOTIVE_CATEGORY=
REMOTIVE_US_ONLY=true

# --- Auth (Phase 8 — stub now) ---
JWT_SECRET=change_me_in_prod
JWT_EXPIRES_IN=3600
