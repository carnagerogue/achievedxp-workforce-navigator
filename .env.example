# --- App ---
NODE_ENV=development
API_PORT=3001
API_HOST=0.0.0.0

# Browser origins allowed to call the API (comma-separated). Required in
# production; in development you can leave it empty and we'll reflect any
# origin. Example: ALLOWED_ORIGINS=https://web-production-059d02.up.railway.app
ALLOWED_ORIGINS=

# Set to `true` to expose Swagger UI at /api/docs in production. Off by
# default; only enable when the docs route sits behind an auth proxy.
EXPOSE_API_DOCS=false

# --- Postgres (matches docker-compose.yml) ---
POSTGRES_USER=dxp
POSTGRES_PASSWORD=dxp_dev_password
POSTGRES_DB=workforce_navigator
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://dxp:dxp_dev_password@localhost:5432/workforce_navigator?schema=public

# --- Redis (required — backs the BullMQ ingestion queue) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Ingestion ---
# Enqueue a single ingestion run on API boot. The worker (in-process)
# consumes it asynchronously, so the API doesn't block startup.
INGEST_RUN_ON_BOOT=true
# Set to `true` to disable the in-process worker on this service. Use
# only when running a separate worker process (e.g. a future Railway
# worker service); leave unset on a single-process deploy.
WORKER_DISABLED=

# --- USAJobs provider ---
# Register at https://developer.usajobs.gov/apirequest/ (5-minute signup).
# USER_AGENT must be the email you registered with; API_KEY is in the email
# they send back.
USAJOBS_ENABLED=false
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=
USAJOBS_KEYWORDS=warehouse,forklift,maintenance,custodian,cook,driver,clerk,laborer
USAJOBS_MAX_PAGES=4

# --- Adzuna provider ---
# Register at https://developer.adzuna.com. Free tier: ~1000 calls/month.
ADZUNA_ENABLED=false
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us
ADZUNA_KEYWORDS=warehouse,forklift,cdl,cook,custodian
ADZUNA_MAX_PAGES=2
ADZUNA_WHERE=

# --- Remotive provider (no auth required) ---
REMOTIVE_ENABLED=false
REMOTIVE_LIMIT=200
REMOTIVE_CATEGORY=
REMOTIVE_US_ONLY=true

# --- Jooble provider ---
# Register at https://jooble.org/api/about. Default plan = 500 req/month.
# We POST to https://jooble.org/api/{api_key}.
JOOBLE_ENABLED=false
JOOBLE_API_KEY=
JOOBLE_KEYWORDS=warehouse,forklift,cdl driver,maintenance,custodian,cook,landscaping,laborer,manufacturing,housekeeping
JOOBLE_LOCATIONS=United States
JOOBLE_MAX_PAGES=2
JOOBLE_RESULTS_PER_PAGE=20
JOOBLE_RADIUS_KM=40

# --- Auth ---
# JWT signing secret. The API refuses to boot if this is missing or still
# set to the placeholder. Generate with `openssl rand -base64 48`.
JWT_SECRET=change_me_in_prod
# Token + cookie lifetime. Accepts the jsonwebtoken shorthand (1h, 7d, …).
JWT_EXPIRES_IN=7d

# Bearer token required for /ingestion/* and /classify/* admin endpoints.
# Leave unset to disable those routes entirely (recommended in prod —
# triggers run via the in-process cron, not via HTTP). Min 16 chars.
ADMIN_TOKEN=

# AES-256-GCM key for column-level PII encryption (firstName, lastName,
# phone, locationCity, conviction notes). Generate once with:
#   openssl rand -base64 32
# Must decode to exactly 32 bytes. The API refuses to boot without this.
# Rotating the key requires a re-encryption migration; never delete or
# change without one.
ENCRYPTION_KEY=
